<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="drop-form_problems" author="przem">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="form_problems"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="form_problems" constraintName="fkkuhxelnnbj14cru0ea87ob0mr"/>
        <dropTable cascadeConstraints="true" tableName="form_problems"/>
    </changeSet>
    <changeSet id="add-problem_form-to-judge_teams" author="przem">
        <addColumn tableName="judge_teams">
            <column name="problem_form_id" type="BIGINT"/>
        </addColumn>
    </changeSet>
    <changeSet id="add-problem_form-fk" author="przem">
        <addForeignKeyConstraint baseColumnNames="problem_form_id" baseTableName="judge_teams"
                                 constraintName="FK_JUDGE_TEAMS_ON_PROBLEM_FORM" referencedColumnNames="id"
                                 referencedTableName="problem_form"/>
    </changeSet>
    <changeSet id="drop-problem-from-judge_teams" author="przem">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="judge_teams" columnName="problem"/>
        </preConditions>
        <dropColumn columnName="problem" tableName="judge_teams"/>
    </changeSet>

</databaseChangeLog>