<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="create-judge_teams" author="przem">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="judge_teams"/>
            </not>
        </preConditions>
        <createTable tableName="judge_teams">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_judge_teams"/>
            </column>
            <column name="problem" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="judge_count_dta" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="judge_count_dtb" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="judge_count_style" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="city_id" type="INT"/>
        </createTable>
    </changeSet>
    <changeSet id="add-city-fk-on-judge_teams" author="przem">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="city"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="FK_JUDGE_TEAMS_ON_CITY"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="city_id" baseTableName="judge_teams"
                                 constraintName="FK_JUDGE_TEAMS_ON_CITY" referencedColumnNames="id"
                                 referencedTableName="city"/>
    </changeSet>

</databaseChangeLog>