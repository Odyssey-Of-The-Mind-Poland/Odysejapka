<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="022-sanitize-info-text" author="odysejapka">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="info"/>
            <columnExists tableName="info" columnName="info_text"/>
        </preConditions>
        <comment>Runs once: strips colours, fonts and sizes from the existing info texts, keeping only the elements the app can draw.</comment>
        <customChange class="odyseja.odysejapka.info.content.SanitizeInfoTextChange"/>
    </changeSet>

</databaseChangeLog>
