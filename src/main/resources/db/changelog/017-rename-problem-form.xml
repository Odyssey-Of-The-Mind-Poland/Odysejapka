<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1789993619118-1" author="przem">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="form_problem_json"/>
            </not>
        </preConditions>
        <createTable tableName="problem_form">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_problem_form"/>
            </column>
            <column name="problem" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="form_data" type="jsonb"/>
        </createTable>
    </changeSet>
    <changeSet id="1789993619118-2" author="przem">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="form_problem_json"/>
        </preConditions>
        <renameTable oldTableName="form_problem_json"
                     newTableName="problem_form"/>
    </changeSet>

</databaseChangeLog>